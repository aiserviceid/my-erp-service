+  position: relative;
+  overflow: hidden;
+  background:
+    radial-gradient(circle at var(--pointer-x) var(--pointer-y), rgba(14,165,233,.1), transparent 25rem),
+    linear-gradient(180deg, #f8fcff 0%, #f3f9fc 45%, #f8fafc 100%);
+}
+
+.landing-ambient {
+  position: absolute;
+  z-index: 0;
+  width: 34rem;
+  height: 34rem;
+  border-radius: 50%;
+  filter: blur(80px);
+  opacity: .22;
+  pointer-events: none;
+  animation: ambientDrift 15s ease-in-out infinite alternate;
+}
+.landing-ambient.one { top: 5rem; right: -16rem; background: #38bdf8; }
+.landing-ambient.two { top: 44rem; left: -18rem; background: #2dd4bf; animation-delay: -7s; }
+.simple-landing > :not(.landing-ambient) { position: relative; z-index: 1; }
+
+.simple-nav {
+  top: 10px;
+  width: calc(100% - 28px);
+  border: 1px solid transparent;
+  border-radius: 22px;
+  transition: background .3s ease, box-shadow .3s ease, border-color .3s ease, padding .3s ease;
+}
+.simple-nav.is-scrolled {
+  padding-top: 10px;
+  padding-bottom: 10px;
+  background: rgba(255,255,255,.82);
+  border-color: rgba(186,230,253,.72);
+  box-shadow: 0 18px 45px rgba(15,23,42,.08);
+}
+.simple-nav-links a { position: relative; }
+.simple-nav-links a::after {
+  content: "";
+  position: absolute;
+  left: 0;
+  right: 100%;
+  bottom: -6px;
+  height: 2px;
+  border-radius: 2px;
+  background: #0ea5e9;
+  transition: right .25s ease;
+}
+.simple-nav-links a:hover::after { right: 0; }
+.simple-nav .nav-login-button {
+  padding: 10px 15px;
